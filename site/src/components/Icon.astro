---
// Простые линейные иконки (stroke = currentColor), без внешних библиотек
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const paths: Record<string, string> = {
  briefcase:
    '<rect x="2.5" y="7" width="19" height="13" rx="2.5"/><path d="M8.5 7V5.5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2V7"/><path d="M2.5 13h19"/>',
