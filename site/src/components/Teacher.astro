---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import site from '../data/site.json';
import photo from '../assets/nazokat-laptop.webp';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section teacher reveal" id="ustoz">
  <div class="container teacher__grid">
    <div class="teacher__photo">
      <Picture
        src={photo}
        alt={t.hero.photoAlt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[360, 480, 778]}
        sizes="(min-width: 900px) 440px, 100vw"
        class="teacher__img"
      />
    </div>

    <div class="teacher__text">
      <span class="eyebrow">{t.teacher.eyebrow}</span>
      <h2>{t.teacher.title}</h2>
      <p class="teacher__role">{t.teacher.role}</p>
      <p class="teacher__intro">{t.teacher.intro}</p>
      {/* Абзац «о себе» показываем, только когда владелец его заполнит */}
      {t.teacher.story && <p class="teacher__story">{t.teacher.story}</p>}
      <ul class="teacher__facts">
        {
          t.teacher.facts.map((f) => (
            <li class:list={{ 'fact--text': !/\d/.test(f.value) }}>
              <strong>{f.value}</strong>
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>
      <a
        class="btn btn--ghost"
        href={`https://instagram.com/${site.instagram}`}
        target="_blank"
        rel="noopener"
        data-event="click_instagram"
      >
        <Icon name="instagram" size={22} />
        {t.teacher.instagram} @{site.instagram}
      </a>
    </div>
  </div>
</section>

<style>
  .teacher__grid {
    display: grid;
    gap: 32px;
  }

  .teacher__photo {
    aspect-ratio: 4 / 5;
    max-width: 440px;
    width: 100%;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--peach);
    box-shadow: var(--shadow);
  }

  .teacher__photo :global(.teacher__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .teacher__role {
    margin-top: 6px;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--terra-dark);
  }

  .teacher__intro {
    margin-block: 20px 12px;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.4;
  }

  .teacher__story {
    color: var(--text-muted);
  }

  /* Факты карточками: крупное значение и подпись */
  .teacher__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 24px 0 28px;
    padding: 0;
    list-style: none;
  }

  .teacher__facts li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 18px;
    border-radius: var(--radius-sm);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .teacher__facts strong {
    font-weight: 900;
    font-size: 26px;
    line-height: 1.15;
    color: var(--terra);
  }

  /* Факт-текст («Oliy maʼlumotli») длиннее цифр — на всю строку и чуть мельче */
  .teacher__facts .fact--text {
    grid-column: 1 / -1;
  }

  .teacher__facts .fact--text strong {
    font-size: 21px;
  }

  .teacher__facts span {
    font-weight: 600;
    font-size: 14px;
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .teacher__grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 64px;
    }
  }
</style>
