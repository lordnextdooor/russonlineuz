---
// Горизонтальный логотип: знак слева, «RUSSONLINEUZ» и подпись справа.
// Надпись — контуры Montserrat (src/assets/wordmark.svg, генерирует `npm run og`):
// текстом в SVG Safari расставлял буквы по запасному шрифту, и «UZ» наезжал на «E».
// Как картинка (role="img") логотип не проверяется на контраст, подпись для скринридера — «RUSSONLINEUZ».
import Mark from './Mark.astro';
import wordmarkSvg from '../assets/wordmark.svg?raw';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;

// id масок satori должны быть уникальными: логотип бывает на странице дважды (шапка и подвал)
const uid = `wm${Math.random().toString(36).slice(2, 8)}`;
const wordmark = wordmarkSvg
  .replace(/^<svg width="\d+" height="\d+"/, '<svg class="logo__word" role="img" aria-label="RUSSONLINEUZ"')
  .replaceAll('satori_', `${uid}_`);
---

<span class:list={['logo', `logo--${variant}`]}>
  <Mark variant={variant} class="logo__mark" />
  <Fragment set:html={wordmark} />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 160px;
  }

  .logo--light {
    --wm-name: #1f2d4d;
    --wm-uz: #c8553d;
    --wm-tagline: #a8432f;
  }

  .logo--dark {
    --wm-name: #fff6ec;
    --wm-uz: #e07a5f;
    --wm-tagline: #f2b5a3;
  }

  .logo :global(.logo__mark) {
    width: 34px;
    height: auto;
    flex: none;
  }

  /* Высота надписи задаёт кегль: 22 px ≈ название 14 px (холст 850×158, кегль названия 100) */
  .logo :global(.logo__word) {
    height: 22px;
    width: auto;
    flex: none;
  }

  @media (min-width: 400px) {
    .logo :global(.logo__mark) {
      width: 42px;
    }
    .logo :global(.logo__word) {
      height: 25px;
    }
  }

  @media (min-width: 768px) {
    .logo :global(.logo__mark) {
      width: 54px;
    }
    .logo :global(.logo__word) {
      height: 32px;
    }
  }
</style>
