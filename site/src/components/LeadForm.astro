---
import type { Dict, Locale } from '../i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t, lang } = Astro.props;
const privacyHref = lang === 'uz' ? '/privacy/' : '/ru/privacy/';
---

<section class="section lead" id="ariza">
  <div class="container lead__inner reveal">
    <div class="lead__head">
      <h2>{t.form.title}</h2>
      <p>{t.form.subtitle}</p>
    </div>

    {/* Заявка уходит в /api/lead → Telegram-бот учителя */}
    <form
      class="lead__form"
      method="post"
      action="/api/lead"
      novalidate
      data-lead-form
      data-thanks={lang === 'ru' ? '/ru/spasibo/' : '/rahmat/'}
      data-msg-sending={t.form.sending}
      data-msg-name={t.form.errorName}
      data-msg-phone={t.form.errorPhone}
      data-msg-send={t.form.errorSend}
      data-msg-rate={t.form.errorRate}
    >
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="tariff" value="" data-tariff-input />
      <input type="hidden" name="ts" value="" data-ts-input />
      {/* Ловушка для ботов: людям не видна */}
      <div class="visually-hidden" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <p class="lead__tariff" hidden data-tariff-note>
        {t.form.tariffChosen} <strong data-tariff-label></strong>
      </p>

      <div class="field">
        <label for="lead-name">{t.form.name} *</label>
        <input id="lead-name" name="name" type="text" autocomplete="given-name" required maxlength="80" />
      </div>

      <div class="field">
        <label for="lead-phone">{t.form.phone} *</label>
        <input
          id="lead-phone"
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          placeholder="+998 __ ___ __ __"
          required
          data-phone
        />
      </div>

      <div class="field">
        <label for="lead-tg">{t.form.telegram} <span class="field__hint">({t.form.optional})</span></label>
        <input id="lead-tg" name="telegram" type="text" placeholder="@username" autocomplete="off" maxlength="40" />
      </div>

      <fieldset class="field choices">
        <legend>{t.form.format}</legend>
        <label><input type="radio" name="format" value="individual" />{t.form.formatIndividual}</label>
        <label><input type="radio" name="format" value="group" />{t.form.formatGroup}</label>
        <label><input type="radio" name="format" value="unknown" checked />{t.form.formatUnknown}</label>
      </fieldset>

      <fieldset class="field choices">
        <legend>{t.form.time}</legend>
        <label><input type="radio" name="time" value="day" />{t.form.timeDay}</label>
        <label><input type="radio" name="time" value="evening" checked />{t.form.timeEvening}</label>
      </fieldset>

      <p class="lead__error" role="alert" hidden data-form-error></p>

      <button type="submit" class="btn btn--primary btn--block" data-submit>{t.form.submit}</button>

      <p class="lead__consent">
        {t.form.consentBefore}<a href={privacyHref}>{t.form.consentLink}</a>
      </p>
    </form>
  </div>
</section>

<style>
  .lead {
    background: linear-gradient(180deg, var(--cream) 0%, rgba(242, 181, 163, 0.35) 100%);
  }

  .lead__inner {
    display: grid;
    gap: 32px;
  }

  .lead__head p {
    margin-top: 14px;
    font-size: 18px;
    color: var(--text-muted);
  }

  .lead__form {
    display: grid;
    gap: 18px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .lead__tariff {
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(242, 181, 163, 0.35);
    font-size: 15px;
  }

  .field {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field > label,
  .field legend {
    padding: 0;
    font-weight: 700;
    font-size: 15px;
  }

  .field__hint {
    font-weight: 500;
    color: var(--text-muted);
  }

  .field input[type='text'],
  .field input[type='tel'] {
    width: 100%;
    min-height: 52px;
    padding: 12px 16px;
    border: 2px solid rgba(31, 45, 77, 0.18);
    border-radius: 14px;
    background: var(--cream);
    color: var(--navy);
    font: 500 17px/1.3 var(--font);
  }

  .field input:focus {
    outline: none;
    border-color: var(--navy);
  }

  .field input[aria-invalid='true'] {
    border-color: var(--terra);
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .choices legend {
    margin-bottom: 8px;
  }

  .choices label {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 16px;
    border: 2px solid rgba(31, 45, 77, 0.18);
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }

  .choices input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .choices label:has(input:checked) {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--cream);
  }

  .choices label:has(input:focus-visible) {
    outline: 3px solid var(--terra);
    outline-offset: 2px;
  }

  .lead__error {
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(200, 85, 61, 0.1);
    color: var(--terra-dark);
    font-weight: 600;
    font-size: 15px;
  }

  .lead__form [data-submit]:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  .lead__consent {
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .lead__inner {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
      gap: 64px;
    }

    .lead__head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }

    .lead__form {
      padding: 36px;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
  const phone = form?.querySelector<HTMLInputElement>('[data-phone]');

  // Маска +998 XX XXX XX XX
  const formatPhone = (value: string) => {
    let digits = value.replace(/\D/g, '');
    if (digits.startsWith('998')) digits = digits.slice(3);
    digits = digits.slice(0, 9);
    const parts = [digits.slice(0, 2), digits.slice(2, 5), digits.slice(5, 7), digits.slice(7, 9)].filter(Boolean);
    return '+998' + (parts.length ? ' ' + parts.join(' ') : ' ');
  };

  phone?.addEventListener('focus', () => {
    if (!phone.value) phone.value = '+998 ';
  });
  phone?.addEventListener('input', () => {
    phone.value = formatPhone(phone.value);
    phone.removeAttribute('aria-invalid');
  });

  // Кнопка «Tanlash» на карточке тарифа → выбранный тариф и формат в форме
  const tariffInput = form?.querySelector<HTMLInputElement>('[data-tariff-input]');
  const tariffNote = form?.querySelector<HTMLElement>('[data-tariff-note]');
  const tariffLabel = form?.querySelector<HTMLElement>('[data-tariff-label]');

  document.querySelectorAll<HTMLAnchorElement>('[data-choose-tariff]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!form || !tariffInput || !tariffNote || !tariffLabel) return;
      tariffInput.value = btn.dataset.chooseTariff ?? '';
      tariffLabel.textContent = btn.dataset.tariffName ?? '';
      tariffNote.hidden = false;
      const radio = form.querySelector<HTMLInputElement>(`input[name="format"][value="${btn.dataset.format}"]`);
      if (radio) radio.checked = true;
    });
  });

  // Время открытия формы — сервер отсеивает слишком быстрые (ботовые) отправки
  const tsInput = form?.querySelector<HTMLInputElement>('[data-ts-input]');
  if (tsInput) tsInput.value = String(Date.now());

  const errorBox = form?.querySelector<HTMLElement>('[data-form-error]');
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const msg = form?.dataset ?? {};

  const showError = (text: string | undefined) => {
    if (!errorBox) return;
    errorBox.textContent = text ?? '';
    errorBox.hidden = !text;
  };

  // Без JS сервер возвращает на страницу с ?error=… — показываем сообщение и здесь
  const urlError = new URLSearchParams(location.search).get('error');
  if (urlError) showError(urlError === 'rate_limited' ? msg.msgRate : msg.msgSend);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = form.querySelector<HTMLInputElement>('#lead-name');
    const nameOk = !!name?.value.trim();
    const phoneOk = (phone?.value.replace(/\D/g, '').length ?? 0) === 12;
    name?.setAttribute('aria-invalid', String(!nameOk));
    phone?.setAttribute('aria-invalid', String(!phoneOk));
    if (!nameOk || !phoneOk) {
      showError(nameOk ? msg.msgPhone : msg.msgName);
      (nameOk ? phone : name)?.focus();
      return;
    }

    showError(undefined);
    const label = submitBtn?.textContent ?? '';
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = msg.msgSending ?? label;
    }

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const body = await res.json().catch(() => ({}));
      if (res.ok && body.ok) {
        location.href = form.dataset.thanks ?? '/';
        return;
      }
      showError(res.status === 429 ? msg.msgRate : res.status === 422 ? msg.msgPhone : msg.msgSend);
    } catch {
      showError(msg.msgSend);
    }

    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = label;
    }
  });
</script>
