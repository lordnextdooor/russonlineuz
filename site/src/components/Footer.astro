---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import type { Dict, Locale } from '../i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t, lang } = Astro.props;
const privacyHref = lang === 'uz' ? '/privacy/' : '/ru/privacy/';
---

<footer class="footer">
  <div class="container footer__inner">
    <Logo variant="dark" />

    <ul class="footer__links">
      <li>
        <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener" data-event="click_instagram">
          <Icon name="instagram" size={20} /> Instagram <span class="footer__handle">@{site.instagram}</span>
        </a>
      </li>
      <li>
        <a href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener" data-event="click_telegram">
          <Icon name="telegram" size={20} /> Telegram <span class="footer__handle">@{site.telegram}</span>
        </a>
      </li>
    </ul>

    <div class="footer__bottom">
      <span>{t.footer.copyright}</span>
      <a href={privacyHref}>{t.footer.privacy}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    /* Снизу место под плавающую кнопку Telegram и плашку Netlify */
    padding-block: 48px 168px;
    background: var(--navy);
    color: var(--cream);
  }

  .footer__inner {
    display: grid;
    gap: 28px;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    text-decoration: none;
  }

  .footer__handle {
    font-weight: 500;
    color: var(--peach);
  }

  .footer__links a:hover {
    color: var(--peach);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 246, 236, 0.16);
    font-size: 14px;
    color: rgba(255, 246, 236, 0.75);
  }

  .footer__bottom a {
    color: var(--peach);
  }

  @media (min-width: 768px) {
    .footer {
      padding-bottom: 48px;
    }

    .footer__inner {
      grid-template-columns: auto 1fr;
      align-items: center;
    }

    .footer__links {
      justify-content: flex-end;
    }

    .footer__bottom {
      grid-column: 1 / -1;
    }
  }
</style>
