  book: '<path d="M4 19V5.5a2 2 0 0 1 2-2h14V17H6a2 2 0 0 0-2 2z"/><path d="M4 19a2 2 0 0 0 2 2h14v-4"/><path d="M9 8h7"/>',
  chat: '<path d="M20.5 14.5a2 2 0 0 1-2 2H8l-4.5 4v-15a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/><path d="M8.5 9.5h7"/>',
  video: '<rect x="2.5" y="6" width="13" height="12" rx="2.5"/><path d="M15.5 10.5l6-3.5v10l-6-3.5"/>',
  check: '<path d="M20 6.5L9.5 17L4 11.5"/>',
  wifi: '<path d="M2.5 9a14 14 0 0 1 19 0"/><path d="M5.5 12.5a9.5 9.5 0 0 1 13 0"/><path d="M9 16a4.5 4.5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="0.6" fill="currentColor"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.8" fill="currentColor"/>',
  telegram: '<path d="M21 4L2.8 11.2c-.9.4-.9 1.6.1 1.9l4.6 1.4L19 7l-9 9 .4 4.3c.1.8 1.1 1.1 1.6.4l2.5-3 4.4 3.2c.7.5 1.7.1 1.9-.7L23 5.2c.2-.9-.9-1.6-2-1.2z"/>',
  menu: '<path d="M3.5 7h17"/><path d="M3.5 12h17"/><path d="M3.5 17h17"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>',
  arrow: '<path d="M5 12h14"/><path d="M13 6l6 6l-6 6"/>',
  chevron: '<path d="M6 9l6 6l6-6"/>',
