---
import Icon from './Icon.astro';
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section audience reveal">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t.audience.eyebrow}</span>
      <h2>{t.audience.title}</h2>
    </div>

    <ul class="audience__grid">
      {
        t.audience.cards.map((card) => (
          <li class="audience__card">
            <span class="audience__icon">
              <Icon name={card.icon} size={26} />
            </span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </li>
        ))
      }
    </ul>

    <p class="audience__motto">{t.audience.motto}</p>
  </div>
</section>

<style>
  .audience__grid {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audience__card {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .audience__icon {
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 16px;
    border-radius: 16px;
    background: rgba(242, 181, 163, 0.4);
    color: var(--terra-dark);
  }

  .audience__card h3 {
    font-size: 18px;
  }

  .audience__card p {
    margin-top: 6px;
    color: var(--text-muted);
  }

  .audience__motto {
    margin-top: 36px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--navy);
    color: var(--cream);
    font-weight: 800;
    font-size: clamp(20px, 4.5vw, 26px);
    line-height: 1.3;
    text-align: center;
  }

  @media (min-width: 600px) {
    .audience__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .audience__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
