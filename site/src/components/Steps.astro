---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section class="section section--navy steps">
  <div class="container reveal">
    <div class="section-head section-head--center">
      <span class="eyebrow">{t.steps.eyebrow}</span>
      <h2>{t.steps.title}</h2>
    </div>

    <ol class="steps__list">
      {
        t.steps.items.map((item, i) => (
          <li>
            <span class="steps__num">{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps__list {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .steps__list li {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .steps__num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    border-radius: 50%;
    background: var(--terra);
    color: var(--white);
    font-weight: 800;
    font-size: 20px;
  }

  .steps__list h3 {
    font-size: 19px;
  }

  .steps__list p {
    margin-top: 6px;
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .steps__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
