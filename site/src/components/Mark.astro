---
// Знак: два облачка диалога — «Aa» (узбекская латиница) и «Яя» (русский)
interface Props {
  variant?: 'light' | 'dark';
  class?: string;
  title?: string;
}

const { variant = 'light', class: className, title } = Astro.props;

const colors =
  variant === 'light'
    ? { aBubble: '#1F2D4D', aText: '#FFFFFF', yBubble: '#C8553D', yText: '#FFFFFF', outline: '#FFF6EC' }
    : { aBubble: '#FFF6EC', aText: '#1F2D4D', yBubble: '#C8553D', yText: '#FFFFFF', outline: '#1F2D4D' };
---

<svg
  class={className}
  viewBox="0 0 100 62"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <path
    fill={colors.aBubble}
    d="M8.5 1.75H52.5A5 5 0 0 1 57.5 6.75V36.75A5 5 0 0 1 52.5 41.75H25L12 52.5L14 41.75H8.5A5 5 0 0 1 3.5 36.75V6.75A5 5 0 0 1 8.5 1.75Z"
  ></path>
  <text
    x="16.5"
    y="30"
    fill={colors.aText}
    font-family="Montserrat, Arial, sans-serif"
    font-weight="800"
    font-size="18">Aa</text
  >
  <path
    fill={colors.yBubble}
    stroke={colors.outline}
    stroke-width="3"
    stroke-linejoin="round"
    paint-order="stroke"
    d="M49 16.5H90A5 5 0 0 1 95 21.5V49A5 5 0 0 1 90 54H82.5L84 60.5L73 54H49A5 5 0 0 1 44 49V21.5A5 5 0 0 1 49 16.5Z"
  ></path>
  <text
    x="57"
    y="43.25"
    fill={colors.yText}
    font-family="Montserrat, Arial, sans-serif"
    font-weight="800"
    font-size="18">Яя</text
  >
</svg>
